import tkinter as tk
import random

root = tk.Tk()
root.title("NHA")
root.geometry("380x650")
root.configure(bg="#101010")

tk.Label(
    root, text="NHA",
    font=("Arial", 28, "bold"),
    fg="red", bg="#101010"
).pack(pady=15)

enabled = False

status = tk.Label(
    root, text="SYSTEM: OFF",
    fg="white", bg="#101010"
)
status.pack()

settings_frame = tk.Frame(root, bg="#101010")

tk.Label(
    settings_frame,
    text="AIM SETTINGS",
    fg="lime", bg="#101010",
    font=("Arial", 16, "bold")
).pack(pady=10)

tk.Label(
    settings_frame,
    text="SENSITIVITY",
    fg="white", bg="#101010"
).pack()

sensitivity = tk.Scale(
    settings_frame,
    from_=1, to=100,
    orient="horizontal",
    bg="#101010", fg="white"
)
sensitivity.set(50)
sensitivity.pack()

tk.Label(
    settings_frame,
    text="CROSSHAIR SIZE",
    fg="white", bg="#101010"
).pack()

size = tk.Scale(
    settings_frame,
    from_=5, to=40,
    orient="horizontal",
    bg="#101010", fg="white"
)
size.set(15)
size.pack()

canvas = tk.Canvas(
    settings_frame,
    width=320, height=250,
    bg="#202020",
    highlightthickness=0
)
canvas.pack(pady=15)

def draw():
    canvas.delete("all")

    x, y = 160, 120
    s = size.get()

    canvas.create_oval(
        x-15, y-15, x+15, y+15,
        outline="red", width=3
    )

    canvas.create_line(
        x-s, y, x+s, y,
        fill="lime", width=2
    )

    canvas.create_line(
        x, y-s, x, y+s,
        fill="lime", width=2
    )

def toggle():
    global enabled

    enabled = not enabled

    if enabled:
        status.config(text="SYSTEM: ON", fg="lime")
        settings_frame.pack(pady=10)
        draw()
    else:
        status.config(text="SYSTEM: OFF", fg="white")
        settings_frame.pack_forget()

def reset():
    sensitivity.set(50)
    size.set(15)
    draw()

tk.Button(
    root,
    text="ON / OFF",
    command=toggle,
    bg="red", fg="white",
    width=20
).pack(pady=15)

tk.Button(
    root,
    text="RESET SETTINGS",
    command=reset,
    bg="#333333", fg="white"
).pack()

size.configure(command=lambda value: draw())

root.mainloop()
